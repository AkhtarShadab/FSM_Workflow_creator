# Local development uses an embedded libSQL file.
# For production / remote Turso, set:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token
TURSO_DATABASE_URL=file:local.db

# Required. AES-256-GCM wrapping key for BYOK credentials (FeatureShipping 005).
# The server refuses to start without it — never falls back to plaintext.
# Generate with: openssl rand -base64 32
PLATFORM_SECRET=

# Optional. Previous wrapping key, accepted for decrypt only during rotation.
# After rotateEncryption() has re-sealed every row, this can be removed.
PLATFORM_SECRET_PREVIOUS=
