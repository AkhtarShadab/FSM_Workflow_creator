# Local development uses an embedded libSQL file.
# For production / remote Turso, set:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token
TURSO_DATABASE_URL=file:local.db

# Tool runtimes (010 G2). Unset → SCRIPT fails with TOOL_RUNTIME_UNAVAILABLE.
# Start them with: docker compose -f docker-compose.dev.yml up --build
# TOOL_ENDPOINTS=[{"id":"python","address":"127.0.0.1:50051","language":"python"},{"id":"bash","address":"127.0.0.1:50052","language":"bash"}]
