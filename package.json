{
  "name": "fsm-workflow-creator",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web exec tsc --noEmit",
    "test": "pnpm --filter web test && pnpm --filter @fsm/engine test && pnpm --filter @fsm/export-engine test",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:migrate": "pnpm --filter web db:migrate"
  }
}
